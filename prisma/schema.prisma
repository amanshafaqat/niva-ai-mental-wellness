// ==============================================================================
// NIVA - Privacy-Conscious AI Mental Wellness Companion
// Database Architecture - Prisma Schema (Phase 1 Foundation)
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// Core User Roles
// ------------------------------------------------------------------------------
enum Role {
  USER       // Primary end-user seeking wellness support
  GUARDIAN   // Trusted contact with explicit consent-based access
  ADMIN      // Platform operational & compliance administrator
}

// ------------------------------------------------------------------------------
// User Model
// ------------------------------------------------------------------------------
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  avatarUrl     String?
  
  // Security & Role-Based Access Control
  role          Role      @default(USER)
  status        String    @default("ACTIVE") // Account status: ACTIVE, SUSPENDED, DEACTIVATED
  isActive      Boolean   @default(true)
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations: Authentication & Session
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  
  // Phase 3: AI Conversation Engine & Wellness Sessions
  conversations    Conversation[]
  preferences      UserPreferences?

  // Phase 4: Realtime Voice Sessions
  voiceSessions    VoiceSession[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

// ------------------------------------------------------------------------------
// User Preferences Model (Phase 3)
// ------------------------------------------------------------------------------
model UserPreferences {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  responseStyle          String   @default("SHORT")              // SHORT, BALANCED, DETAILED
  conversationPreference String   @default("LISTEN_AND_RESPOND") // JUST_LISTEN, LISTEN_AND_RESPOND, HELP_ME_SOLVE
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ------------------------------------------------------------------------------
// Conversation Model (Phase 3 Wellness Session)
// ------------------------------------------------------------------------------
model Conversation {
  id        String                @id @default(uuid())
  userId    String
  title     String                @default("Wellness Session")
  status    String                @default("ACTIVE") // ACTIVE, ENDED
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  endedAt   DateTime?

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      ConversationMessage[]
  voiceSessions VoiceSession[]

  @@index([userId])
  @@index([userId, status])
  @@index([createdAt])
  @@map("conversations")
}

// ------------------------------------------------------------------------------
// Voice Session Model (Phase 4 Realtime Voice Engine)
// ------------------------------------------------------------------------------
model VoiceSession {
  id              String       @id @default(uuid())
  userId          String
  conversationId  String
  status          String       @default("INITIALIZING") // INITIALIZING, ACTIVE, ENDED, FAILED
  startedAt       DateTime     @default(now())
  endedAt         DateTime?
  durationSeconds Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([status])
  @@map("voice_sessions")
}

// ------------------------------------------------------------------------------
// Conversation Message Model (Phase 3)
// ------------------------------------------------------------------------------
model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // "user", "assistant", "system"
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

// ------------------------------------------------------------------------------
// Account Model (Federated Identity & Google OAuth)
// ------------------------------------------------------------------------------
model Account {
  id                 String    @id @default(uuid())
  userId             String
  type               String    // e.g. "oauth"
  provider           String    // e.g. "google"
  providerAccountId  String    // Google 'sub' claim
  scope              String?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// ------------------------------------------------------------------------------
// Session Model (Server-side Session State)
// ------------------------------------------------------------------------------
model Session {
  id           String    @id @default(uuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("sessions")
}

// ------------------------------------------------------------------------------
// Audit Log Model (Security & Governance Trail)
// ------------------------------------------------------------------------------
model AuditLog {
  id          String    @id @default(uuid())
  userId      String?
  action      String    // e.g. "USER_LOGIN_SUCCESS", "ROLE_VERIFIED", "RBAC_ACCESS_DENIED"
  entityType  String?   // e.g. "User", "Session", "Consent"
  entityId    String?   // Targeted entity ID
  metadata    Json?     // Structured context (sanitized, non-sensitive)
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}
