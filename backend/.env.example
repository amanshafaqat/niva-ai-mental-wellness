# ==============================================================================
# NIVA Backend - Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/niva_wellness?schema=public"

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# JWT & Session Security
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"
SESSION_SECRET="replace-with-another-secure-random-32-character-key"
JWT_EXPIRES_IN="7d"

# Server Execution
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Initial Platform Administrator Email
INITIAL_ADMIN_EMAIL="admin@niva.internal"

# Rate Limiting & Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100
